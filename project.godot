; GameBox 3D Runner — Android black screen fix profile.
; Uses compatibility renderer to avoid Vulkan/mobile renderer black-screen issues on some phones.

config_version=5

[application]
config/name="GameBox 3D Runner"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.03, 0.06, 1)
boot_splash/show_image=true

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=3
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.035, 0.065, 1)
textures/vram_compression/import_etc2_astc=true
